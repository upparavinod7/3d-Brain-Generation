# Medical Uploads & Generated Outputs (keep directory structure via .gitkeep)
storage/uploads/*
storage/processed/*
storage/outputs/*
!storage/uploads/.gitkeep
!storage/processed/.gitkeep
!storage/outputs/.gitkeep

# Environment variables
.env
.env.local
.env.development.local
.env.test.local
.env.production.local

