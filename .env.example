# -----------------------------------------------------------------------------
# 3D Brain Generation AI Platform - Environment Configuration Template (.env.example)
# Copy this file to .env and set your environment variables / API keys
# -----------------------------------------------------------------------------

# Application Environment & Server Settings
ENVIRONMENT=development
SERVER_HOST=0.0.0.0
SERVER_PORT=8000

# Security & API Keys
SECRET_KEY=your-super-secret-key-here
API_KEY=your-api-key-here

# Backend Public Base URL
BACKEND_PUBLIC_URL=http://localhost:8000

# Next.js Frontend Environment Variables (Exposed to Browser)
NEXT_PUBLIC_BACKEND_URL=http://localhost:8000
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1
NEXT_PUBLIC_API_KEY=your-api-key-here

# Medical Data Storage Paths
UPLOAD_DIR=storage/uploads
PROCESSED_DIR=storage/processed
OUTPUT_DIR=storage/outputs
